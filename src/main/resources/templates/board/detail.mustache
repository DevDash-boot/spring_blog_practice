{{> layout/header}}

<section class="container content-container">
    <a href="/board/list" class="back-link">
        <i class="fa-solid fa-arrow-left me-2"></i> 게시글 목록
    </a>

    <!-- 게시글 상세 -->
    <article class="article-card">
        <div class="article-header">
            <span class="category-label">DEVELOPMENT</span>
            <h1>{{board.title}}</h1>
            <div class="article-meta">
                <span><i class="fa-regular fa-user me-1"></i>{{board.username}}</span>
                <span><i class="fa-regular fa-calendar me-1"></i>{{board.createdAt}}</span>
            </div>
        </div>

        <div class="article-content">{{board.content}}</div>

        <div class="article-content">
            {{#board.canRead}}
                {{board.content}}
            {{/board.canRead}}

            {{^board.canRead}}
                <div class="text-center p-4">
                    <p>유료 게시글입니다. 구매 후 내용을 볼 수 있습니다.</p>
                    <p>금액은 500P입니다.</p>

                    {{#sessionUser}}
                        <form action="/board/{{board.id}}/purchase"
                              method="POST"
                              onsubmit="return confirm('500포인트로 이 게시글을 구매하시겠습니까?')">
                            <button type="submit" class="btn btn-primary">
                                구매하기 500P
                            </button>
                        </form>
                    {{/sessionUser}}

                    {{^sessionUser}}
                        <a href="/login" class="btn btn-outline-primary">
                            로그인 후 구매
                        </a>
                    {{/sessionUser}}
                </div>
            {{/board.canRead}}
        </div>

        <div class="article-actions">
            <div class="like-section">
                <button type="button" id="likeButton" class="btn btn-outline-danger">
                    <i id="likeIcon"
                       class="{{#board.liked}}fa-solid{{/board.liked}}{{^board.liked}}fa-regular{{/board.liked}} fa-heart"></i>
                    좋아요 <span id="likeCount">{{board.likeCount}}</span>
                </button>
            </div>

            <a href="/board/list" class="btn btn-outline-dark">목록으로</a>

            {{#isOwner}}
                <a href="/board/{{board.id}}/update" class="btn btn-dark">수정하기</a>
                <form action="/board/{{board.id}}/delete" method="post"
                      onsubmit="return confirm('정말 삭제하시겠습니까?');">
                    <button type="submit" class="btn btn-outline-danger">삭제하기</button>
                </form>
            {{/isOwner}}
        </div>
    </article>

    <!-- 댓글 영역 -->
    <section class="mt-4">
        <div class="card">
            <div class="card-header">
                <b>댓글 작성</b>
            </div>

            <div class="card-body">
                {{#sessionUser}}
                    <form action="/reply/save" method="post">
                        <input type="hidden" name="boardId" value="{{board.id}}">

                        <div class="mb-3">
                            <textarea
                                    name="content"
                                    class="form-control"
                                    rows="3"
                                    placeholder="댓글을 입력하세요."
                                    required></textarea>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">댓글 등록</button>
                        </div>
                    </form>
                {{/sessionUser}}

                {{^sessionUser}}
                    <p class="mb-0">
                        댓글을 작성하려면 <a href="/login">로그인</a>해 주세요.
                    </p>
                {{/sessionUser}}
            </div>
        </div>
    </section>

    <!-- 댓글 목록 -->
    <section class="mt-4">
        <div class="card-header mb-2">
            <b>댓글 목록</b>
            <span class="text-muted">({{replyList.size}})</span>
        </div>

        <div class="list-group">
            {{#replyList}}
                <div class="list-group-item reply-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <b>{{username}}</b>
                            <span class="reply-content">{{content}}</span>

                            {{#isOwner}}
                                <form action="/reply/{{id}}/update"
                                      method="post"
                                      class="reply-edit-form d-none mt-2">

                        <textarea name="content"
                                  class="form-control mb-2"
                                  rows="2"
                                  required>{{content}}</textarea>

                                    <div class="text-end">
                                        <button type="submit"
                                                class="btn btn-primary btn-sm">저장</button>
                                        <button type="button"
                                                class="btn btn-secondary btn-sm cancel-edit">취소</button>
                                    </div>
                                </form>
                            {{/isOwner}}
                        </div>

                        {{#isOwner}}
                            <div class="ms-2 text-nowrap reply-actions">
                                <button type="button"
                                        class="btn btn-warning btn-sm edit-reply">수정</button>

                                <form action="/reply/{{id}}/delete"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('댓글을 삭제하시겠습니까?');">
                                    <button type="submit"
                                            class="btn btn-danger btn-sm">삭제</button>
                                </form>
                            </div>
                        {{/isOwner}}
                    </div>
                </div>
            {{/replyList}}

            {{^replyList}}
                <div class="list-group-item text-center text-muted py-4">
                    등록된 댓글이 없습니다.
                </div>
            {{/replyList}}
        </div>
    </section>
</section>

<script>
    const likeButton = document.getElementById('likeButton');
    likeButton.addEventListener('click', async function () {
        if (likeButton.disabled) return;        // 연타 방지
        likeButton.disabled = true;
        const boardId = '{{board.id}}';
        try {
            const response = await fetch(`/api/boards/${boardId}/like`, { method: 'POST' });

            if (response.status === 401) {
                alert('로그인이 필요합니다.');
                location.href = '/login';
                return;
            }
            if (!response.ok) {
                alert('좋아요 처리에 실패했습니다.');
                return;
            }

            const data = await response.json();
            document.getElementById('likeCount').textContent = data.likeCount;
            const icon = document.getElementById('likeIcon');
            icon.classList.toggle('fa-solid', data.liked);
            icon.classList.toggle('fa-regular', !data.liked);
        } catch (error) {
            alert('서버와 통신할 수 없습니다.');
        } finally {
            likeButton.disabled = false;       // return 해도 finally는 실행됨
        }
    });

    // 댓글 수정 입력창 열기
    document.querySelectorAll('.edit-reply').forEach(button => {
        button.addEventListener('click', function () {
            const item = this.closest('.reply-item');
            item.querySelector('.reply-content').classList.add('d-none');
            item.querySelector('.reply-edit-form').classList.remove('d-none');
            item.querySelector('.reply-actions').classList.add('d-none');
        });
    });

    // 댓글 수정 취소
    document.querySelectorAll('.cancel-edit').forEach(button => {
        button.addEventListener('click', function () {
            const item = this.closest('.reply-item');
            item.querySelector('.reply-content').classList.remove('d-none');
            item.querySelector('.reply-edit-form').classList.add('d-none');
            item.querySelector('.reply-actions').classList.remove('d-none');
        });
    });
</script>

{{> layout/footer}}