{{> layout/header}}

<section class="hero-section">
    <div class="container">
        <span class="eyebrow">DEVELOPER COMMUNITY</span>
        <h1>개발자의 생각을<br>기록하고 공유하세요.</h1>
        <p>개발 경험과 공부 기록을 나누는 개발자 커뮤니티입니다.</p>
    </div>
</section>

<section class="container board-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">COMMUNITY</span>
            <h2>최근 게시글</h2>
            <p>다양한 개발 이야기와 지식을 확인해 보세요.</p>
        </div>
    </div>

    <form action="/" method="get" class="d-flex mb-4">
        <input type="text"
               class="form-control me-2"
               placeholder="제목 또는 내용으로 검색"
               name="keyword"
               value="{{keyword}}">
        <button type="submit" class="btn btn-primary text-nowrap me-2">
            검색
        </button>
        <a href="/" class="btn btn-secondary text-nowrap">초기화</a>
    </form>

    {{#isSearch}}
        <p><b>{{keyword}}</b> 검색 결과 {{boardPage.totalElements}}건</p>
    {{/isSearch}}

    <div class="board-list">
        {{#boardPage.content}}
            <article class="board-card">
                <div class="board-card-top">
                    <span class="category-label">DEVELOPMENT</span>
                    <span class="board-date">{{createdAt}}</span>
                </div>
                <h3>{{title}}</h3>
                <div class="board-card-bottom">
                    <span><i class="fa-regular fa-user"></i> {{username}}</span>
                    <a href="/board/{{id}}" class="text-link">
                        상세보기 <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </article>
        {{/boardPage.content}}

        {{^boardPage.content}}
            <div class="empty-state">
                <i class="fa-regular fa-folder-open"></i>
                <h3>아직 게시글이 없습니다.</h3>
                <p>첫 번째 게시글이 등록되면 이곳에 표시됩니다.</p>
            </div>
        {{/boardPage.content}}
    </div>

    <ul class="pagination justify-content-center mt-4">
        {{#boardPage.hasPrevious}}
            <li class="page-item">
                <a class="page-link"
                   href="/?page={{boardPage.previousPage}}&size={{boardPage.size}}&keyword={{keywordParam}}">
                이전
                </a>
            </li>
        {{/boardPage.hasPrevious}}

        {{#boardPage.pagesLinks}}
            <li class="page-item {{#active}}active{{/active}}">
                <a class="page-link"
                   href="/?page={{number}}&size={{boardPage.size}}&keyword={{keywordParam}}">
                {{number}}
                </a>
            </li>
        {{/boardPage.pagesLinks}}

        {{#boardPage.hasNext}}
            <li class="page-item">
                <a class="page-link"
                   href="/?page={{boardPage.nextPage}}&size={{boardPage.size}}&keyword={{keywordParam}}">
                다음
                </a>
            </li>
        {{/boardPage.hasNext}}
    </ul>
</section>

{{> layout/footer}}