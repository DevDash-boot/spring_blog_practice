<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevBlog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span class="brand-mark">&lt;/&gt;</span> DevBlog
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false"
                    aria-label="메뉴 열기">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/board/list">게시글</a>
                    </li>
                    {{#sessionUser}}
                        <li class="nav-item">
                            <a class="nav-link" href="/board/save">글쓰기</a>
                        </li>
                    {{/sessionUser}}
                </ul>
                <div class="navbar-actions">

                    {{#sessionUser}}
                        <span class="user-greeting">{{sessionUser.username}}님</span>
                        <a class="btn btn-outline-dark btn-sm" href="/user/update">내 정보</a>
                        <a class="btn btn-dark btn-sm" href="/logout">로그아웃</a>
                    {{/sessionUser}}

                    {{^sessionUser}}
                        <a class="btn btn-outline-dark btn-sm" href="/login">로그인</a>
                        <a class="btn btn-dark btn-sm" href="/join">회원가입</a>
                    {{/sessionUser}}

                </div>
            </div>
        </div>
    </nav>
</header>
<main class="site-main">