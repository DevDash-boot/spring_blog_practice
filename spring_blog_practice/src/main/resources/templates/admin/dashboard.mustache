{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><h2 class="mb-0">관리자 대시보드</h2></div>
        <div class="card-body">
            <h4 class="mb-2">안녕하세요, {{adminName}}님</h4>
            <p class="text-muted mb-4">이 페이지는 관리자만 접근할 수 있습니다.</p>

            <!-- 환불 요청 현황 -->
            <div class="row g-3 mb-4 text-center">
                <div class="col-6 col-md-3">
                    <a href="/admin/refund/list?status=PENDING" class="text-decoration-none">
                        <div class="border rounded p-3 bg-warning-subtle">
                            <div class="small text-muted">대기중</div>
                            <div class="fs-3 fw-bold text-dark">{{refundCount.pending}}</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/admin/refund/list?status=APPROVED" class="text-decoration-none">
                        <div class="border rounded p-3 bg-success-subtle">
                            <div class="small text-muted">승인됨</div>
                            <div class="fs-3 fw-bold text-dark">{{refundCount.approved}}</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/admin/refund/list?status=REJECTED" class="text-decoration-none">
                        <div class="border rounded p-3 bg-danger-subtle">
                            <div class="small text-muted">거절됨</div>
                            <div class="fs-3 fw-bold text-dark">{{refundCount.rejected}}</div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/admin/refund/list" class="text-decoration-none">
                        <div class="border rounded p-3 bg-light">
                            <div class="small text-muted">전체</div>
                            <div class="fs-3 fw-bold text-dark">{{refundCount.total}}</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a href="/admin/refund/list" class="btn btn-primary">
                    <i class="fa-solid fa-rotate-left me-1"></i>환불 요청 관리
                </a>
                <a href="/board/list" class="btn btn-secondary btn-sm">게시글 목록으로</a>
            </div>
        </div>
    </div>
</div>

{{> layout/footer}}
